# Copy to .env for local development; Flask loads it through python-dotenv.
FLASK_APP=acme_inventory:create_app
FLASK_DEBUG=false
# Set a stable random secret for deployed instances.
# ACME_SECRET_KEY=
# Absolute paths are recommended for runtime storage.
# ACME_INSTANCE_PATH=C:/path/to/acme-instance
# ACME_DATABASE_URL=sqlite:///C:/path/to/inventory.db
# ACME_UPLOAD_DIR=C:/path/to/uploads

